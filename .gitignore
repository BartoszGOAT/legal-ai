# Environnement
.venv/
__pycache__/
*.pyc
.DS_Store

# Donnees BSARD telechargeables via src/data.py::download_bsard() (voir INSTALL.md)
# -- pas la peine de versionner des CSV re-telechargeables depuis HuggingFace.
data/*.csv
!data/abstention_questions.csv

# Sorties volumineuses de kernels Kaggle (index d'embeddings, copies de donnees)
# -- regenerables en relancant le kernel correspondant, cf. RESULTS.md pour les
# metriques deja extraites (results/*.json, versionnes).
kaggle_kernels/*/output/

# Poids des adaptateurs LoRA entraines (sauvegarde locale post-incident volume
# RunPod du 30/07) -- trop volumineux pour un depot de code, pas leur place ici.
# Les metriques (finetune_meta_*.json) restent versionnees, pas les poids.
adapters_local/
